# Sealed secrets for ARC runners.
# Populated at Phase 13 after the GitHub App is created.
#
# Required sealed secret: arc-github-app
#   Fields:
#     github_app_id              — numeric App ID from GitHub App settings page
#     github_app_installation_id — numeric Installation ID (org-level install)
#     github_app_private_key     — contents of the .pem private key file
#
# GitHub App setup steps (do before Phase 13):
#   1. Go to https://github.com/organizations/stephenj-code/settings/apps/new
#   2. Name: solomon-arc
#   3. Permissions:
#        Repository: Actions (read), Administration (read/write), Metadata (read)
#        Organization: Self-hosted runners (read/write)
#   4. Install the app on the stephenj-code organization
#   5. Note the App ID and Installation ID from the app settings page
#   6. Generate and download a private key (.pem)
#
# Seal the secret:
#   kubectl create secret generic arc-github-app \
#     --namespace arc-runners \
#     --from-literal=github_app_id=<app-id> \
#     --from-literal=github_app_installation_id=<installation-id> \
#     --from-literal=github_app_private_key="$(cat solomon-arc.private-key.pem)" \
#     --dry-run=client -o yaml | \
#     kubeseal --cert scripts/sealed-secrets.pem --format yaml \
#     > infrastructure/ci-cd/arc/sealed-secrets/arc-github-app-sealed.yaml
#
# Delete the .pem file from disk after sealing.
